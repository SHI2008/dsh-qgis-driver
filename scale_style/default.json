{
  "name": "default",
  "description": "Standard line-width table based on common drafting practice. base_mm is the paper width at the reference scale band (the band with factor=1.0 = 1:5,000-1:25,000); multiply by the band factor to get the recommended width for each scale. real_width_m is a representative value (approximate) when drawing by real-world width (m). User defaults can be overridden by a same-name or differently-named profile in ~/.qgis-live/scale_style/*.json",
  "scale_bands": [
    {"max": 2500,   "label": "up to 1:2,500",    "factor": 1.5},
    {"max": 5000,   "label": "up to 1:5,000",    "factor": 1.3},
    {"max": 10000,  "label": "up to 1:10,000",   "factor": 1.15},
    {"max": 25000,  "label": "up to 1:25,000",   "factor": 1.0},
    {"max": 50000,  "label": "up to 1:50,000",   "factor": 0.8},
    {"max": 100000, "label": "up to 1:100,000",  "factor": 0.65},
    {"max": 250000, "label": "up to 1:250,000",  "factor": 0.5},
    {"max": null,   "label": "1:250,000 and smaller",  "factor": 0.4}
  ],
  "categories": [
    {
      "key": "motorway",
      "match": {"name_re": "高速|自動車道|motorway|expressway"},
      "base_mm": 0.7,
      "real_width_m": 20.0
    },
    {
      "key": "road_major",
      "match": {"name_re": "国道|主要|幹線|trunk|primary|major"},
      "base_mm": 0.55,
      "real_width_m": 13.0
    },
    {
      "key": "railway",
      "match": {"name_re": "鉄道|rail|線路|軌道"},
      "base_mm": 0.45,
      "real_width_m": 10.0
    },
    {
      "key": "river",
      "match": {"name_re": "河川|river|waterway|stream|用水|排水|水路"},
      "base_mm": 0.3,
      "real_width_m": null
    },
    {
      "key": "boundary",
      "match": {"name_re": "界|boundary|境界|行政|admin"},
      "base_mm": 0.25,
      "real_width_m": null
    },
    {
      "key": "road",
      "match": {"name_re": "道|road|street|route|way"},
      "base_mm": 0.4,
      "real_width_m": 6.0
    },
    {
      "key": "contour",
      "match": {"name_re": "等高|contour|曲線"},
      "base_mm": 0.12,
      "real_width_m": null
    },
    {
      "key": "building",
      "match": {"name_re": "建物|建築|building|structure"},
      "base_mm": 0.15,
      "real_width_m": null
    },
    {
      "key": "line",
      "match": {"geom": "line"},
      "base_mm": 0.3,
      "real_width_m": null
    },
    {
      "key": "polygon",
      "match": {"geom": "polygon"},
      "base_mm": 0.15,
      "real_width_m": null
    },
    {
      "key": "default",
      "match": {},
      "base_mm": 0.3,
      "real_width_m": null
    }
  ]
}

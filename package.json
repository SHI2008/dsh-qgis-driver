{
  "name": "dsh-qgis-driver",
  "version": "0.1.93-rc",
  "type": "module",
  "main": "./dsh-tools/index.js",
  "icon": "./dsh-tools/icon.png",
  "exports": {
    ".": "./dsh-tools/index.js",
    "./client": "./dsh-tools/client.js",
    "./locale/*.json": "./dsh-tools/locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "dsh-tools/client.js",
    "dsh-tools/cordis.patch.yml",
    "dsh-tools/docs",
    "dsh-tools/index.js",
    "dsh-tools/locale/*.json",
    "dsh-tools/node_modules",
    "dsh-tools/scripts",
    "dsh-tools/skills",
    "dsh-tools/tests",
    "dsh-tools/icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "qgis",
    "gis"
  ],
  "description": "Drive QGIS from DeepSeek Harness through qgis_* tools: layers, symbology, layouts, Processing and PNG/PDF export.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHI2008/dsh-qgis-driver.git"
  },
  "homepage": "https://github.com/SHI2008/dsh-qgis-driver#readme",
  "bugs": {
    "url": "https://github.com/SHI2008/dsh-qgis-driver/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "SHI2008",
  "devDependencies": {
    "acorn": "^8.19.0"
  }
}
